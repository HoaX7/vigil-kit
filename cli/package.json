{
  "name": "@hoax7/vigil-cli",
  "version": "0.2.4",
  "description": "Vigil uptime monitoring from the terminal. Create monitors, manage projects and wire alerts without opening the dashboard.",
  "type": "module",
  "bin": {
    "vigil": "dist/vigil.mjs"
  },
  "files": [
    "dist/vigil.mjs",
    "README.md",
    "LICENSE"
  ],
