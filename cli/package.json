  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HoaX7/vigil-sdk.git",
    "directory": "cli"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.11",
    "typescript": "^5.7.2"
  }
}
